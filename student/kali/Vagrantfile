Vagrant.configure("2") do |config|

  config.vm.box = "techforwardacademy/kali"
  config.vm.box_url = "https://boxes.techforward.ai/metadata/kali.json"
  config.vm.box_version = "1.0.0"

  config.ssh.username = "techforward"
  config.ssh.insert_key = false

  config.vm.hostname = "tf-kali"

  # Kali's NetworkManager keeps the second NIC on DHCP by default.
  # Let Vagrant create the host-only NIC, then configure it deterministically.
  config.vm.network "private_network", ip: "10.9.8.93", auto_config: false

  config.vm.provision "shell",
    privileged: true,
    env: { "TF_PRIVATE_IP" => "10.9.8.93" },
    inline: <<-SHELL
      set -e
      nmcli connection modify "Wired connection 2"         ipv4.method manual         ipv4.addresses "$TF_PRIVATE_IP/24"         ipv4.gateway ""         ipv4.dns ""         connection.autoconnect yes
      nmcli connection up "Wired connection 2"
    SHELL

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
    vb.gui = false
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
  end

end
