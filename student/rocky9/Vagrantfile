Vagrant.configure("2") do |config|

  config.vm.box = "techforwardacademy/rocky9"
  config.vm.box_url = "https://boxes.techforward.ai/metadata/rocky9.json"
  config.vm.box_version = "1.0.1"

  config.ssh.username = "techforward"

  config.vm.hostname = "tf-rocky9"

  config.vm.network "private_network", ip: "10.9.8.XX"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
    vb.gui = false
  end

end
